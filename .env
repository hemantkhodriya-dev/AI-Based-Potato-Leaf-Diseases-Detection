# =============================================================================
# PotatoCare AI — Environment Configuration Template
# Copy this file to .env and configure values according to your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Express Backend Gateway Configuration
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# URL of the Python FastAPI AI Microservice
AI_SERVICE_URL=https://onrender.com

# MongoDB Database Connection String
# For MongoDB Atlas Cloud Cluster:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/potatocare?retryWrites=true&w=majority
# For Local MongoDB Service:
MONGO_URI=mongodb://127.0.0.1:27017/potatocare

# -----------------------------------------------------------------------------
# 2. Python FastAPI AI Microservice Configuration
# -----------------------------------------------------------------------------
AI_HOST=127.0.0.1
AI_PORT=8000
MODEL_DIR=./models
CALIBRATION_TEMPERATURE=4.0

# -----------------------------------------------------------------------------
# 3. React Frontend Configuration (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:5000
VITE_DEV_PORT=3000
